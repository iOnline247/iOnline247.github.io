---
layout: base.njk
pagination:
  data: collections.publishedPosts
  size: 5
---
<section class="site-card rounded-3xl p-6 sm:p-8" aria-labelledby="posts-heading">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="site-pill inline-flex rounded-full px-3 py-1 text-sm font-semibold uppercase tracking-[0.2em]">Latest posts</p>
    </div>
  
  </div>
  <ul class="mt-6 space-y-3">
  {% for post in pagination.items %}
    <li class="site-post-item rounded-2xl p-4 transition">
      <a href="{{ post.url }}" class="site-link text-lg">{{ post.data.title }}</a>
      <p class="mt-2 text-sm text-slate-700">{{ post.data.description or 'Read the full article for more detail.' }}</p>
    </li>
  {% endfor %}
  </ul>
</section>