---
layout: base.njk
pagination:
  data: collections.publishedPosts
  size: 5
---
<section class="site-card rounded-3xl p-6 sm:p-8" aria-labelledby="posts-heading">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="site-pill inline-flex rounded-full px-4 py-1.5 text-base font-semibold uppercase tracking-[0.2em]">Latest posts</p>
    </div>
  
  </div>
  <ul class="mt-6 space-y-3">
  {% for post in pagination.items %}
    <li class="site-post-item rounded-2xl transition">
      <a href="{{ post.url }}" class="site-post-link block h-full rounded-2xl p-4">
        <span class="site-link site-post-title text-lg">{{ post.data.title }}</span>
        <span class="site-post-meta mt-2 block text-xs uppercase tracking-[0.12em]">
          <time datetime="{{ (post.data.publishedTimestamp or post.date) | htmlDate }}">{{ (post.data.publishedTimestamp or post.date) | displayDateShort }}</time>
          <span aria-hidden="true">&nbsp;&bull;&nbsp;</span>
          <span>{{ post.templateContent | readingMinutes }} min read</span>
        </span>
        <span class="mt-2 block text-sm text-slate-700">{{ post.data.description or 'Read the full article for more detail.' }}</span>
      </a>
    </li>
  {% endfor %}
  </ul>
</section>