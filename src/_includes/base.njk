<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}" />
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:type" content="article">
  <link rel="stylesheet" href="/assets/site.css">
</head>
<body class="min-h-screen px-4 py-4 sm:px-6 sm:py-5 lg:px-8">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="site-shell mx-auto max-w-4xl rounded-[2rem] p-5 sm:p-7 lg:p-8">
    <header class="mb-6 border-b border-slate-200 pb-5" aria-labelledby="site-title">
      <div class="flex flex-col gap-4">
        <div class="grid gap-3 sm:grid-cols-[1fr_auto] sm:items-start">
          <p class="site-pill inline-flex rounded-full px-4 py-1.5 text-base font-semibold uppercase tracking-[0.2em] sm:col-start-1 sm:row-start-1">Notes from the field</p>
          <div class="sm:col-start-1 sm:row-start-2">
            <h1 id="site-title" class="site-title-display mt-3 text-4xl sm:text-5xl"><a href="/" class="text-inherit no-underline">Matthew’s Blog</a></h1>
            {% if page.url == "/" %}
              <p class="site-tagline site-tagline-home mt-2 max-w-[58ch] text-sm sm:text-base text-slate-700" aria-label="Building better systems: Pragmatic guides to code, security, and human-centric architecture.">
                <span class="site-tagline-prefix">Building better systems:</span>
                <span class="site-tagline-typed">Pragmatic guides to code, security, and human-centric architecture.</span>
              </p>
            {% endif %}
          </div>
          <div class="w-full sm:col-start-2 sm:row-start-1 sm:w-auto sm:min-w-[15.5rem] sm:max-w-[18rem]">
            <div class="search-terminal" data-search-shell>
              <label class="sr-only" for="searchInput">Search posts</label>
              <span class="search-terminal-prefix" aria-hidden="true">
                <span>search&gt;</span>
              </span>
              <input id="searchInput" type="text" class="search-terminal-input" placeholder="type to search" aria-label="Search posts" autocomplete="off" spellcheck="false" enterkeyhint="search" aria-describedby="searchStatus" />
            </div>
          </div>
        </div>
        <p id="searchStatus" class="sr-only" aria-live="polite" aria-atomic="true"></p>
        <div id="searchResults" data-search-preview class="search-results mt-1 space-y-2" aria-live="polite" aria-atomic="true"></div>
      </div>
    </header>
    <main id="main-content">
      {{ content | safe }}
    </main>
  </div>
  <script type="module" src="/assets/components/islands.js"></script>
  <script type="module" src="/assets/search.js"></script>
</body>
</html>